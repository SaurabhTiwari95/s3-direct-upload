# Copy to .env with:  python scripts/make_env.py   (it fills in a random API key). .env is git-ignored.
# AWS credentials never go in this file: boto3 reads them from your AWS CLI profile (AWS_PROFILE)
# locally, or from the IAM role when deployed. See docs/aws-setup.md.

# The private bucket you created in docs/aws-setup.md
S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1
# AWS CLI profile holding the least-privilege user's keys (local runs only; leave empty when deployed)
AWS_PROFILE=s3-direct-upload

# Who may call the API, as JSON {"owner-id": "api-key"}; keys 32+ characters, one per owner.
API_KEYS={"demo-user": "replace-with-a-long-random-key-at-least-32-characters"}

# The Angular app's origin: the only origin CORS allows
FRONTEND_ORIGIN=http://localhost:4200

MAX_UPLOAD_BYTES=10485760
UPLOAD_URL_TTL_SECONDS=300
DOWNLOAD_URL_TTL_SECONDS=60
RATE_LIMIT_PER_MINUTE=30
DATABASE_PATH=data/uploads.db
